<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>
    <%= title %>
  </title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Arial, sans-serif;
      color: #1a1a2e;
      background: #f4f6f9;
      line-height: 1.5;
    }

    .page {
      max-width: 900px;
      margin: 24px auto;
      padding: 0 16px;
    }

    .card {
      background: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    }

    .card-header {
      background: linear-gradient(135deg, #1a1a2e 0%, #2d2d44 100%);
      padding: 24px 28px;
      color: #fff;
    }

    .card-header h1 {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    .card-header .sub {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 8px;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.7);
    }

    .card-header .sub strong {
      color: #fff;
    }

    .card-body {
      padding: 20px 28px;
    }

    .meta-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid #eef2f7;
      font-size: 12px;
      color: #6b7280;
    }

    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      background: #f0f4ff;
      color: #d4af37;
      font-weight: 700;
      font-size: 11px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }

    thead th {
      background: #f8fafc;
      color: #1a1a2e;
      font-weight: 700;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 10px 12px;
      border-bottom: 2px solid #d4af37;
      text-align: left;
    }

    thead th.right {
      text-align: right;
    }

    tbody td {
      padding: 9px 12px;
      border-bottom: 1px solid #eef2f7;
      color: #374151;
    }

    tbody td.right {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    tbody tr:nth-child(even) {
      background: #fafbfc;
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    .footer {
      margin-top: 20px;
      padding-top: 14px;
      border-top: 1px solid #eef2f7;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      color: #9ca3af;
    }

    .footer strong {
      color: #6b7280;
    }

    @media print {
      body {
        background: #fff;
      }

      .page {
        margin: 0 auto;
      }

      .card {
        box-shadow: none;
        border: 1px solid #e5e7eb;
      }

      .card-header {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      thead th {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      tbody tr:nth-child(even) {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="card">
      <div class="card-header">
        <h1>
          <%= title %>
        </h1>
        <div class="sub">
          <span>Período: <strong>
              <%= desde %>
            </strong> — <strong>
              <%= hasta %>
            </strong></span>
          <span>Generado: <strong>
              <%= generatedAt %>
            </strong></span>
        </div>
      </div>
      <div class="card-body">
        <div class="meta-row">
          <span>
            <%= negocio || '' %>
          </span>
          <span class="badge">
            <%= generatedBy || 'Sistema' %>
          </span>
        </div>

        <table>
          <thead>
            <tr>
              <% headers.forEach(function(h){ %>
                <th class="<%= h.align==='right' ? 'right' : '' %>">
                  <%= h.label %>
                </th>
                <% }) %>
            </tr>
          </thead>
          <tbody>
            <% if(!rows || !rows.length) { %>
              <tr>
                <td colspan="<%= headers.length %>" style="text-align:center;padding:32px 0;color:#9ca3af;">No hay datos
                  disponibles</td>
              </tr>
              <% } else { %>
                <% rows.forEach(function(row){ %>
                  <tr>
                    <% row.forEach(function(cell){ %>
                      <td class="<%= cell.align==='right' ? 'right' : '' %>"><%- cell.html %></td>
                      <% }) %>
                  </tr>
                  <% }) %>
                    <% } %>
          </tbody>
        </table>

        <div class="footer">
          <div>Reporte generado por <strong>
              <%= generatedBy || 'Sistema' %>
            </strong></div>
          <div>© <%= new Date().getFullYear() %>
              <%= negocio || '' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>

</html>